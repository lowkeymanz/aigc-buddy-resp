{
  "type": "workflow",
  "class_name": "MiniMaxH3Ref2vaNative",
  "name": "MiniMax-H3 素材参考生视频",
  "description": "MiniMax-H3 素材参考生视频（RunningHub 原生 ComfyUI 工作流），可组合文本、参考图片（最多3张）、参考视频（最多1段）、参考音频（最多1段）等多模态素材生成视频，输出视频自带环境音效。支持 1:1、3:4、4:3、9:16、16:9 五种画面比例，可自定义视频时长（秒）。适合角色/场景/氛围参考创作、音画配合等场景。\n\n【提示词写法】先声明每个素材的角色定位，再描述目标视频内容。示例：<图片1> 是主体外观参考；<图片2> 是环境氛围参考。目标视频：雨夜东京街头，<图片1>中的女人自然行走，镜头从背后跟随，霓虹灯光在湿滑路面上反射。",
  "ui_group": "视频创作",
  "cover_image": "assets/workflow_covers/rh_wf/minimax_h3_ref2va_native.png",
  "source_type": "rh_native",
  "instance_type": "standard",
  "source_data": "config/models/graphs/minimax_h3_ref2va.json",
  "input_transform": "minimax_h3_ratio",
  "input_mapping": {
    "positive": {
      "node_id": "138",
      "field": "value"
    },
    "seconds": {
      "node_id": "132",
      "field": "value"
    },
    "width": {
      "node_id": "136",
      "field": "width"
    },
    "height": {
      "node_id": "136",
      "field": "height"
    }
  },
  "dynamic_slots": {
    "ref_images": {
      "target_node": "136",
      "field_pattern": "ref_images.ref_image_{i}",
      "loader": {
        "class_type": "LoadImage",
        "field": "image"
      },
      "max_count": 3
    },
    "ref_videos": {
      "target_node": "136",
      "field_pattern": "ref_videos.ref_video_{i}",
      "loader": {
        "class_type": "LoadVideo",
        "field": "file"
      },
      "via": {
        "class_type": "GetVideoComponents",
        "input": "video"
      },
      "max_count": 1
    },
    "ref_audios": {
      "target_node": "136",
      "field_pattern": "ref_audios.ref_audio_{i}",
      "loader": {
        "class_type": "LoadAudio",
        "field": "audio"
      },
      "max_count": 1
    }
  },
  "category": "i2v",
  "ui_schema": [
    {
      "name": "positive",
      "label": "提示词",
      "widget_type": "text_area",
      "required": true,
      "placeholder": "先声明素材定位（如 <图片1> 是主体外观参考），再描述目标视频内容、运镜与氛围..."
    },
    {
      "name": "ref_images",
      "label": "参考图片",
      "widget_type": "image_upload",
      "required": false,
      "default": [],
      "max_count": 3,
      "description": "最多 3 张，作为主体外观/场景/风格参考"
    },
    {
      "name": "ref_videos",
      "label": "参考视频",
      "widget_type": "video_upload",
      "required": false,
      "default": [],
      "max_count": 1,
      "description": "最多 1 段，作为动作或镜头参考"
    },
    {
      "name": "ref_audios",
      "label": "参考音频",
      "widget_type": "audio_upload",
      "required": false,
      "default": [],
      "max_count": 1,
      "description": "最多 1 段，作为声音氛围参考"
    },
    {
      "name": "ratio",
      "label": "画面比例",
      "widget_type": "combo_box",
      "required": false,
      "default": 5,
      "options": [
        "1:1 (640×640)",
        "3:4 (576×768)",
        "4:3 (768×576)",
        "9:16 (480×832)",
        "16:9 (832×480)"
      ],
      "option_values": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    {
      "name": "seconds",
      "label": "时长 (秒)",
      "widget_type": "number",
      "required": false,
      "default": 10,
      "min_value": 1,
      "max_value": 15,
      "step": 1
    }
  ]
}
