{
  "type": "workflow",
  "class_name": "QwenImage21T2INative",
  "name": "Qwen-Image-2.1 文生图（标准版）",
  "description": "Qwen-Image-2.1 是阿里通义千问新一代文生图模型（RunningHub 原生 ComfyUI 工作流）。擅长中英文文字渲染，海报招牌、广告牌、UI 截图等场景中的文字清晰准确；人像真实自然、皮肤质感细腻，摄影写实能力强。支持 8 种画面比例（1:1 方形到 21:9 超宽屏）与 0.1-16 百万像素的目标分辨率控制，默认 1MP（约 1024×1024，1MP ≈ 1024×1024）。优势：文字渲染、写实人像、复杂场景构图；适合海报设计、电商配图、写实摄影风格创作。",
  "ui_group": "图片创作",
  "cover_image": "assets/workflow_covers/rh_wf/qwen_image_21_t2i.png",
  "source_type": "rh_native",
  "instance_type": "standard",
  "source_data": "config/models/graphs/qwen_image_21_t2i.json",
  "input_mapping": {
    "positive": {
      "node_id": "483",
      "field": "text"
    },
    "aspect_ratio": {
      "node_id": "13",
      "field": "aspect_ratio"
    },
    "megapixels": {
      "node_id": "13",
      "field": "megapixels"
    }
  },
  "category": "t2i",
  "ui_schema": [
    {
      "name": "positive",
      "label": "提示词",
      "widget_type": "text_area",
      "required": true,
      "placeholder": "描述画面内容，支持中英文文字渲染（如招牌、海报上的文字）..."
    },
    {
      "name": "aspect_ratio",
      "label": "画面比例",
      "widget_type": "combo_box",
      "required": false,
      "default": "16:9 (Widescreen)",
      "options": [
        "1:1 (Square)",
        "2:3 (Portrait Photo)",
        "3:2 (Photo)",
        "3:4 (Portrait Standard)",
        "4:3 (Standard)",
        "9:16 (Portrait Widescreen)",
        "16:9 (Widescreen)",
        "21:9 (Ultrawide)"
      ]
    },
    {
      "name": "megapixels",
      "label": "百万像素 (MP)",
      "widget_type": "number",
      "required": false,
      "default": 1,
      "min_value": 0.1,
      "max_value": 16,
      "step": 0.1,
      "description": "目标总像素量，1 MP ≈ 1024×1024；越大越清晰，生成越慢"
    }
  ]
}
