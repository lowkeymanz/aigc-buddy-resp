{
  "type": "workflow",
  "class_name": "MiniMaxH3Fl2vaNative",
  "name": "MiniMax-H3 关键帧生视频",
  "description": "MiniMax-H3 关键帧生视频（RunningHub 原生 ComfyUI 工作流）。首帧与尾帧各自可选、至少提供一个：只传首帧 = 首帧图生视频（以该图作为视频起点向前发展）；只传尾帧 = 尾帧图生视频（生成向该画面收敛的过程）；两者都传 = 首尾帧生视频（从首帧连续过渡到尾帧）。输出视频自带环境音效。支持 1:1、3:4、4:3、9:16、16:9 五种画面比例，可自定义视频时长（秒）。适合需要精确控制视频起止画面的场景，如动作过渡、场景变换等。\n\n【提示词写法】本模型有专属的结构化提示词规范，传入不同的帧组合对应不同的模式与提示词结构。调用前必须先用 get_prompt_spec 判定模式（I2VA / FL2VA / L2VA）并获取规范，严格按规范编写，禁止凭通用经验编写。",
  "ui_group": "视频创作",
  "cover_image": "assets/workflow_covers/rh_wf/minimax_h3_fl2va_native.png",
  "source_type": "rh_native",
  "instance_type": "standard",
  "source_data": "config/models/graphs/minimax_h3_fl2va.json",
  "input_transform": "minimax_h3_ratio",
  "input_mapping": {
    "positive": {
      "node_id": "168",
      "field": "value"
    },
    "seconds": {
      "node_id": "170",
      "field": "value"
    },
    "width": {
      "node_id": "183",
      "field": "width"
    },
    "height": {
      "node_id": "183",
      "field": "height"
    }
  },
  "dynamic_slots": {
    "first_frame": {
      "target_node": "183",
      "field": "first_frame",
      "loader": {
        "class_type": "LoadImage",
        "field": "image"
      },
      "max_count": 1
    },
    "last_frame": {
      "target_node": "183",
      "field": "last_frame",
      "loader": {
        "class_type": "LoadImage",
        "field": "image"
      },
      "max_count": 1
    }
  },
  "category": "i2v",
  "supported_modes": [
    "I2VA",
    "L2VA",
    "FL2VA"
  ],
  "param_constraints": {
    "at_least_one_of": [
      ["first_frame", "last_frame"]
    ]
  },
  "ui_schema": [
    {
      "name": "positive",
      "label": "提示词",
      "widget_type": "text_area",
      "required": true,
      "placeholder": "提示词结构由本次生成模式决定，请先调用 get_prompt_spec 获取规范：I2VA 需首行首帧对齐指令，FL2VA 需首尾帧对齐指令与连续运动路径，L2VA 需尾帧对齐指令与前置状态推演"
    },
    {
      "name": "first_frame",
      "label": "首帧图片",
      "widget_type": "image_upload",
      "required": false,
      "description": "与尾帧至少提供一个。只传首帧 = 首帧图生视频；两者都传 = 首尾帧生视频"
    },
    {
      "name": "last_frame",
      "label": "尾帧图片",
      "widget_type": "image_upload",
      "required": false,
      "description": "与首帧至少提供一个。只传尾帧 = 尾帧图生视频；两者都传 = 首尾帧生视频"
    },
    {
      "name": "ratio",
      "label": "画面比例",
      "widget_type": "combo_box",
      "required": false,
      "default": 5,
      "options": [
        "1:1 (640×640)",
        "3:4 (576×768)",
        "4:3 (768×576)",
        "9:16 (480×832)",
        "16:9 (832×480)"
      ],
      "option_values": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    {
      "name": "seconds",
      "label": "时长 (秒)",
      "widget_type": "number",
      "required": false,
      "default": 5,
      "min_value": 5,
      "max_value": 15,
      "step": 1
    }
  ]
}
