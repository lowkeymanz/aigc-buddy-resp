{
  "type": "workflow",
  "class_name": "MiniMaxH3Fl2vaNative",
  "name": "MiniMax-H3 首尾帧生视频",
  "description": "MiniMax-H3 首尾帧生视频（RunningHub 原生 ComfyUI 工作流），基于输入的首帧和尾帧图片生成动态视频，视频内容从首帧画面自然过渡到尾帧画面，输出视频自带环境音效。支持 1:1、3:4、4:3、9:16、16:9 五种画面比例，可自定义视频时长（秒）。适合需要精确控制视频起止画面的场景，如动作过渡、场景变换等。\n\n【提示词写法】描述从首帧到尾帧的过渡过程，可按时间段分步描述。示例：0-2秒：中远景，旅人静立于悬崖边缘俯瞰云海，微风拂过长袍。2-5秒：镜头向前推进至面部特写，旅人缓缓侧头，金色晨光铺满脸庞，眼神坚定。",
  "ui_group": "视频创作",
  "cover_image": "assets/workflow_covers/rh_wf/minimax_h3_fl2va_native.png",
  "source_type": "rh_native",
  "instance_type": "standard",
  "source_data": "config/models/graphs/minimax_h3_fl2va.json",
  "input_transform": "minimax_h3_ratio",
  "input_mapping": {
    "positive": {
      "node_id": "168",
      "field": "value"
    },
    "seconds": {
      "node_id": "170",
      "field": "value"
    },
    "width": {
      "node_id": "183",
      "field": "width"
    },
    "height": {
      "node_id": "183",
      "field": "height"
    }
  },
  "dynamic_slots": {
    "first_frame": {
      "target_node": "183",
      "field": "first_frame",
      "loader": {
        "class_type": "LoadImage",
        "field": "image"
      },
      "max_count": 1
    },
    "last_frame": {
      "target_node": "183",
      "field": "last_frame",
      "loader": {
        "class_type": "LoadImage",
        "field": "image"
      },
      "max_count": 1
    }
  },
  "category": "i2v",
  "ui_schema": [
    {
      "name": "positive",
      "label": "提示词",
      "widget_type": "text_area",
      "required": true,
      "placeholder": "按时间描述首帧到尾帧的过渡。例如：0-2秒：首帧状态，人物静立...2-5秒：镜头推进，过渡到尾帧状态..."
    },
    {
      "name": "first_frame",
      "label": "首帧图片",
      "widget_type": "image_upload",
      "required": true
    },
    {
      "name": "last_frame",
      "label": "尾帧图片",
      "widget_type": "image_upload",
      "required": true
    },
    {
      "name": "ratio",
      "label": "画面比例",
      "widget_type": "combo_box",
      "required": false,
      "default": 5,
      "options": [
        "1:1 (640×640)",
        "3:4 (576×768)",
        "4:3 (768×576)",
        "9:16 (480×832)",
        "16:9 (832×480)"
      ],
      "option_values": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    {
      "name": "seconds",
      "label": "时长 (秒)",
      "widget_type": "number",
      "required": false,
      "default": 10,
      "min_value": 1,
      "max_value": 15,
      "step": 1
    }
  ]
}
